{
  "name": "@vbobel/design-system",
  "workspaces": [
    "packages/ui/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces",
    "build:styles-ui": "npm run build --w packages/ui/styles",
    "build:react-ui": "npm run build --w packages/ui/react",
    "dev": "npm run dev --workspaces",
    "deploy-storybook": "npm run deploy-storybook --workspaces",
    "prerelease": "npm run build --workspaces",
    "prepare": "husky install",
    "prettier": "prettier --write .",
    "release": "echo \"Create command with workspaces\" && exit 1",
    "storybook": "npm run storybook --workspaces",
    "storybook:build-storybook": "npm run build-storybook --workspaces"
  },
  "devDependencies": {
    "@commitlint/cli": "^16.2.1",
    "@commitlint/config-conventional": "^16.2.1",
    "husky": "^7.0.0",
    "prettier": "^2.5.1"
  }
}
